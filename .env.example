# VulnScope runtime
HOST=127.0.0.1
PORT=5173

# Optional server-side source tokens. Public GitHub reads are anonymous.
# GITHUB_TOKEN is ignored; the issue token belongs only in the browser form.
NVD_API_KEY=
VULNCHECK_API_TOKEN=

# Abuse protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
REFRESH_RATE_LIMIT_MAX=6
RESEARCH_CONCURRENCY=4
RESEARCH_QUEUE_MAX=20
OUTBOUND_CONCURRENCY=8
OUTBOUND_QUEUE_MAX=50
CACHE_MAX_ENTRIES=300
RESPONSE_MAX_BYTES=8388608
API_BODY_MAX_BYTES=262144
# Overall budget, including queues and every upstream stage; capped at 17000.
API_DEADLINE_MS=17000
ENRICHMENT_PACKAGE_MAX=50
ENRICHMENT_VULNERABILITY_MAX=40
ENRICHMENT_OUTBOUND_MAX_CALLS=41
ENRICHMENT_OUTBOUND_MAX_BYTES=33554432
ENRICHMENT_DEADLINE_MS=15000
GITHUB_REPOSITORY_PACKAGE_MAX=50
GITHUB_REPOSITORY_SBOM_INSPECT_MAX=20000
GITHUB_REPOSITORY_TREE_INSPECT_MAX=50000
GITHUB_REPOSITORY_LOCKFILE_MAX=10
GITHUB_REPOSITORY_LOCKFILE_MAX_BYTES=4194304
GITHUB_REPOSITORY_INVENTORY_MAX_BYTES=16777216
GITHUB_REPOSITORY_INVENTORY_DEADLINE_MS=15000

# Set only for a loopback proxy that OVERWRITES X-Forwarded-For with one client IP.
# Appended chains are rejected; never expose the backend directly.
TRUST_PROXY=0

# AWS deploy script options. Email plus 1-25 valid CVEs enable monitoring.
# Deploy also requires DEPLOYMENT_BUNDLE_PATH, DEPLOYMENT_BUNDLE_SHA256,
# RELEASE_SOURCE_SHA and RELEASE_SOURCE_REF from an approved release.
AWS_PROFILE=json
EXPECTED_AWS_ACCOUNT_ID=171058045575
NOTIFICATION_EMAIL=
MONITORED_CVES=
MONITOR_SCHEDULE=rate(1 day)
