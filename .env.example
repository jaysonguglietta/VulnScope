# VulnScope runtime
HOST=127.0.0.1
PORT=5173

# Optional source tokens
NVD_API_KEY=
GITHUB_TOKEN=
VULNCHECK_API_TOKEN=

# Abuse protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
REFRESH_RATE_LIMIT_MAX=6
RESEARCH_CONCURRENCY=4
RESEARCH_QUEUE_MAX=20
OUTBOUND_CONCURRENCY=8
OUTBOUND_QUEUE_MAX=50
CACHE_MAX_ENTRIES=300
RESPONSE_MAX_BYTES=8388608
API_BODY_MAX_BYTES=262144
ENRICHMENT_PACKAGE_MAX=200
ENRICHMENT_VULNERABILITY_MAX=120

# Set only when a trusted reverse proxy is providing X-Forwarded-For.
TRUST_PROXY=0

# AWS deploy script options. Both email and CVE list are required to enable monitoring.
AWS_PROFILE=json
EXPECTED_AWS_ACCOUNT_ID=171058045575
NOTIFICATION_EMAIL=
MONITORED_CVES=
MONITOR_SCHEDULE=rate(1 day)
